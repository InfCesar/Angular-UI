            "templateData": "\r\n<div class=\"container\">\r\n  <h1>UI Components</h1>\r\n  <h2>Buttons</h2>\r\n  <div class=\"buttons primary-buttons\">\r\n    <button ui-button disabled>Disabled button</button>\r\n    <button ui-button>Enabled button</button>\r\n    <a ui-button href=\"https://www.google.com\">Anchor with button styles</a>\r\n  </div>\r\n\r\n  <div class=\"buttons success-buttons\">\r\n    <button ui-button disabled>Disabled button</button>\r\n    <button ui-button>Enabled button</button>\r\n    <a ui-button href=\"https://www.google.com\">Anchor with button styles</a>\r\n  </div>\r\n\r\n  <h2>Calendar</h2>\r\n\r\n  <div class=\"control\">\r\n    <label>\r\n      Primer día de la semana:\r\n      <select [formControl]=\"firstDayOfWeek\">\r\n        <option *ngFor=\"let option of options; let i = index\" [ngValue]=\"i\">\r\n          {{option}}\r\n        </option>\r\n      </select>\r\n    </label>\r\n  </div>\r\n  <div class=\"control\">\r\n    <label>\r\n      Modo:\r\n      <select [formControl]=\"mode\">\r\n        <option [ngValue]=\"1\">\r\n          Individual\r\n        </option>\r\n        <option [ngValue]=\"2\">\r\n          Rango\r\n        </option>\r\n      </select>\r\n    </label>\r\n  </div>\r\n\r\n  <div class=\"calendar-container\">\r\n    <div class=\"controls\">\r\n      <button (click)=\"monthIndex = monthIndex - 1\">prev</button>\r\n      <button (click)=\"monthIndex = monthIndex + 1\">next</button>\r\n    </div>\r\n    <div class=\"calendar\">\r\n      <div class=\"months\">\r\n        <div class=\"months-col\">\r\n          Month index: {{monthIndex}}\r\n          <ui-calendar-month\r\n            [(selected)]=\"selectedDate\"\r\n            [monthIndex]=\"monthIndex\"\r\n            [year]=\"2024\"\r\n            [firstDayOfWeek]=\"selectedFirstDayOfweek\"\r\n          ></ui-calendar-month>\r\n        </div>\r\n        <div class=\"months-col\">\r\n          Month index: {{monthIndex + 1}}\r\n          <ui-calendar-month\r\n            [(selected)]=\"selectedDate\"\r\n            [monthIndex]=\"monthIndex + 1\"\r\n            [year]=\"2024\"\r\n            [firstDayOfWeek]=\"selectedFirstDayOfweek\"\r\n          ></ui-calendar-month>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  {{selectedDates | json}}\r\n\r\n</div>"
