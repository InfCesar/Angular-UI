{
  "name": "alc-datepicker",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test  --watch=false",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier . --write",
    "prepare": "husky && husky install",
    "storybook": "ng run alc-datepicker-app:storybook",
    "storybook:build": "ng run alc-datepicker-app:build-storybook",
    "storybook:test": "start-server-and-test storybook http://localhost:6006 'test-storybook --url http://localhost:6006 --maxWorkers=2'"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@angular/router": "^21.2.17",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/build": "^21.2.17",
    "@angular/cli": "^21.2.17",
    "@angular/compiler-cli": "^21.2.17",
    "@chromatic-com/storybook": "^5.2.1",
    "@compodoc/compodoc": "^1.1.25",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-links": "^10.4.6",
    "@storybook/angular": "^10.4.6",
    "@storybook/test-runner": "^0.24.4",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "axe-playwright": "^2.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-storybook": "^10.4.6",
    "husky": "^9.1.3",
    "jasmine-core": "~5.1.0",
    "jest": "^30.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^15.2.7",
    "ng-packagr": "^21.2.5",
    "prettier": "3.3.3",
    "start-server-and-test": "^3.0.11",
    "storybook": "^10.4.6",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.{ts,html}": "eslint --cache --fix",
    "*.{ts,html,js,json,scss,css,md}": "prettier --write"
  }
}
